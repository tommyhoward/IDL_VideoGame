[sub_resource type="GDScript" id="GDScript_oul6g"]
script/source = "extends CharacterBody3D

const WALK_SPEED = 5.0
const SPRINT_SPEED = 8.0
const JUMP_VELOCITY = 4.5
const SENSITIVITY = 0.003
const ROTATION_SPEED = 10.0

var score = 0
var health: float = 100.0
var max_health: float = 100.0
var gravity = ProjectSettings.get_setting(\"physics/3d/default_gravity\")
var current_spell = \"fireball\" 

@onready var camera = $Camera3D
@onready var anim = $AnimationPlayer 
@onready var beam_cast = $Camera3D/ShapeCast3D 
@onready var beam_visual = $Camera3D/ShapeCast3D/MeshInstance3D 
@onready var ground_ray = $Camera3D/RayCast3D 
@onready var health_ui = $StaticCanvasLayer/PlayerHealthBar
@onready var magic_circle = $MovingCanvasLayer/MagicCercle
func _ready():
	magic_circle.modulate = Color(1.0, 0.3, 0.0)
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	if beam_cast: beam_cast.enabled = false 
	beam_cast.add_exception(self)
	if beam_visual: beam_visual.visible = false
	update_health_ui()

func _unhandled_input(event):
	if event is InputEventMouseMotion:
		rotate_y(-event.relative.x * SENSITIVITY)
		camera.rotate_x(-event.relative.y * SENSITIVITY)
		camera.rotation.x = clamp(camera.rotation.x, deg_to_rad(-80), deg_to_rad(80))
	
	if Input.is_key_pressed(KEY_1):
		current_spell = \"fireball\"
		_hide_beam()
		magic_circle.modulate = Color(1.0, 0.3, 0.0)
		
	if Input.is_key_pressed(KEY_2):
		current_spell = \"beam\"
		magic_circle.modulate = Color(0.8, 0.0, 1.0)
		
	if Input.is_key_pressed(KEY_3):
		current_spell = \"rock\"
		_hide_beam()
		magic_circle.modulate = Color(0.6, 0.4, 0.2)
	if Input.is_key_pressed(KEY_1):
		current_spell = \"fireball\"
		_hide_beam()
	if Input.is_key_pressed(KEY_2):
		current_spell = \"beam\"
	if Input.is_key_pressed(KEY_3):
		current_spell = \"rock\"
		_hide_beam()

func _physics_process(delta):
	
	magic_circle.rotation += 1.5
	
	if not is_on_floor():
		velocity.y -= gravity * delta
	
	$StaticCanvasLayer/ScoreLabel.text = \"Score: \" + str(score)

	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	var speed = SPRINT_SPEED if Input.is_key_pressed(KEY_SHIFT) else WALK_SPEED
	var input_dir = Input.get_vector(\"a\", \"d\", \"w\", \"s\")
	var direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	
	if direction:
		velocity.x = direction.x * speed
		velocity.z = direction.z * speed
	else:
		velocity.x = move_toward(velocity.x, 0, speed)
		velocity.z = move_toward(velocity.z, 0, speed)

	move_and_slide()
	
	if beam_visual and beam_visual.visible:
		beam_visual.rotate_y(ROTATION_SPEED * delta)
	
	if Input.is_action_pressed(\"shoot\"):
		if current_spell == \"fireball\":
			if %Timer.is_stopped():
				if anim: anim.play(\"cast\")
				shoot_bullet()
		elif current_spell == \"beam\":
			if anim and not anim.is_playing(): anim.play(\"cast\")
			shoot_beam(delta)
		elif current_spell == \"rock\":
			if %Timer.is_stopped():
				if anim: anim.play(\"cast\")
				shoot_rock()
	else:
		if current_spell == \"beam\":
			_hide_beam()

func _hide_beam():
	if beam_cast: beam_cast.enabled = false
	if beam_visual: beam_visual.visible = false

func take_damage(amount: float):
	health -= amount
	update_health_ui()
	if health <= 0:
		get_tree().reload_current_scene()

func update_health_ui():
	if health_ui:
		health_ui.value = health

func shoot_bullet():
	const BULLET_3D = preload(\"uid://b8khm2ljjx8se\")
	var new_bullet = BULLET_3D.instantiate()
	%Marker3D.add_child(new_bullet)
	new_bullet.global_transform = %Marker3D.global_transform
	%Timer.start()

func shoot_beam(delta):
	if beam_cast == null: return
	beam_cast.enabled = true
	if beam_visual: beam_visual.visible = true
	beam_cast.force_shapecast_update() 
	for i in range(beam_cast.get_collision_count()):
		var collider = beam_cast.get_collider(i)
		if is_instance_valid(collider) and collider.has_method(\"take_damage\"):
			collider.take_damage(5.0 * delta)

func shoot_rock():
	if ground_ray.is_colliding():
		var spawn_pos = ground_ray.get_collision_point()
		const ROCK_SCENE = preload(\"res://Other scenes/RockSpike.tscn\")
		var rock = ROCK_SCENE.instantiate()
		get_tree().root.add_child(rock)
		rock.global_position = spawn_pos
		%Timer.start()
"

