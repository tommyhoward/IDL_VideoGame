[sub_resource type="GDScript" id="GDScript_rkbax"]
script/source = "extends CanvasLayer

const SWAY_AMOUNT = 50.0
const SMOOTHNESS = 4.0

func _process(delta):
	var mouse_input = Input.get_last_mouse_velocity().x
	

	var target_offset = -mouse_input * (SWAY_AMOUNT / 1000.0)
	

	offset.x = lerp(offset.x, target_offset, delta * SMOOTHNESS)
"

