[sub_resource type="GDScript" id="GDScript_6ro4h"]
script/source = "extends CharacterBody3D

@export var base_health: float = 10.0
@export var base_movement_speed: float = 4.0
@export var attack_damage: float = 10.0

var health: float
var max_health: float 
var movement_speed: float
var gravity = ProjectSettings.get_setting(\"physics/3d/default_gravity\")
var player: CharacterBody3D

@onready var nav_agent: NavigationAgent3D = $NavigationAgent3D
@onready var health_bar = $HealthBar 
@onready var attack_zone = $AttackZone
@onready var attack_timer = $AttackTimer

func _ready():
	var scale_factor = randf_range(0.5, 1.5)
	scale = Vector3.ONE * scale_factor
	health = base_health * scale_factor
	max_health = health 
	movement_speed = base_movement_speed / scale_factor
	player = get_tree().root.find_child(\"player\", true, false)
	
	if health_bar:
		health_bar.update_bar(health, max_health)

func take_damage(amount: float):
	health -= amount
	if health_bar:
		health_bar.update_bar(health, max_health)
	if health <= 0:
		if player:
			player.score += 1
		queue_free()

func _physics_process(delta: float):
	if not is_on_floor():
		velocity.y -= gravity * delta

	if not player:
		move_and_slide()
		return

	# Attack logic
	if attack_timer.is_stopped():
		for body in attack_zone.get_overlapping_bodies():
			if body == player:
				attack_player()

	nav_agent.target_position = player.global_position
	
	if nav_agent.is_navigation_finished():
		velocity.x = 0
		velocity.z = 0
		move_and_slide()
		return

	var direction = (nav_agent.get_next_path_position() - global_position).normalized()
	velocity.x = direction.x * movement_speed
	velocity.z = direction.z * movement_speed
	
	if velocity.length() > 0.1:
		look_at(Vector3(player.global_position.x, global_position.y, player.global_position.z), Vector3.UP)
		rotate_y(PI)
	
	move_and_slide()

func attack_player():
	if player.has_method(\"take_damage\"):
		player.take_damage(attack_damage)
		attack_timer.start()
"

